NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mxfacil
DB_USER=mxfacil_user
DB_PASS=
# Generar un valor independiente para cada secreto. ENCRYPTION_KEY requiere 64 caracteres hex.
JWT_SECRET=
HMAC_SECRET=
ENCRYPTION_KEY=
CSRF_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
MERCADOPAGO_ENV=sandbox
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Plazos del piloto. La reserva contra entrega se conserva hasta cancelar o despachar.
RESERVA_DIGITAL_MINUTOS=30
RESERVA_TRANSFERENCIA_MINUTOS=1440
# Castores mediante Envia.com. Sin token se usa cotización de mostrador y rastreo público.
ENVIA_ENTORNO=sandbox
ENVIA_API_TOKEN=
# JSON de direcciones reales por ID de proveedor. Ver qa/LOGISTICA.md.
ENVIA_ORIGENES_MX={}
# Variables del contenedor MySQL de Docker Compose
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Precio provisional Pro, en centavos MXN. Solo Stripe sk_test_ para membresias.
PRO_PRICE_CENTS=19900
